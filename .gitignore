# Validate-cached cache. One file per manifest SHA. Safe to wipe.
.cache/

# Bundled server: install.sh creates .venv on demand. Never commit it.
plugins/profile-and-optimize/server/.venv/
plugins/profile-and-optimize/server/**/__pycache__/

# Evidence bundles can use operator-defined family names. Ignore the complete
# artifact tree so logs, environment captures, and credentials cannot be added
# under an unlisted family. Keep directory markers only.
plugins/profile-and-optimize/server/experiments/artifacts/**
!plugins/profile-and-optimize/server/experiments/artifacts/**/
!plugins/profile-and-optimize/server/experiments/artifacts/**/.gitkeep
