{
  "description": "Claude Code registers the provenance commit guard as a PreToolUse Bash hook through claude-hook-adapter.sh.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/claude-hook-adapter.sh ${CLAUDE_PLUGIN_ROOT}/hooks/provenance-commit-gate.sh"
          }
        ]
      }
    ]
  }
}
